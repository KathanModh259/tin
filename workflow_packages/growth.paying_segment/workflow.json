{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.paying_segment",
    "title": "Find who pays and stays",
    "description": "Read Stripe subscriptions, find the customer segment that keeps paying, and hand that target to the outreach shortlist and keyword plan. Read-only; no model calls.",
    "version": "1.0.0",
    "executor": "workflow.code",
    "system": "cold-outreach",
    "schedule_modes": ["on_demand", "weekly"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "retention_days": {
          "type": "integer",
          "minimum": 14,
          "maximum": 180,
          "default": 60,
          "title": "Days a customer must keep paying to count as stayed",
          "x-tin-ui": {"control": "counter", "order": 10}
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 90,
          "maximum": 1095,
          "default": 365,
          "title": "How far back to read subscriptions (days)",
          "x-tin-ui": {"control": "counter", "order": 20}
        },
        "min_segment_size": {
          "type": "integer",
          "minimum": 3,
          "maximum": 50,
          "default": 5,
          "title": "Smallest segment worth comparing",
          "x-tin-ui": {"control": "counter", "order": 30}
        },
        "exclude_domains": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "default": [],
          "items": {"type": "string", "minLength": 3, "maxLength": 253},
          "title": "Your own and test email domains to leave out"
        },
        "product_summary": {
          "type": "string",
          "maxLength": 500,
          "default": "",
          "title": "One sentence on what you sell, for the keyword hand-off",
          "x-tin-ui": {"control": "textarea", "order": 50}
        }
      },
      "required": ["project_id"]
    },
    "integration_requirements": [
      {"provider_key": "custom.api.stripe", "capabilities": ["http.read"], "required": true}
    ],
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": ["main.py"],
      "timeout_seconds": 60,
      "services": {
        "stripe": {"provider_key": "custom.api.stripe", "max_calls": 8, "max_response_bytes": 64000}
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/growth/PAYING_SEGMENT.md",
        "media_type": "text/markdown",
        "max_bytes": 64000
      }
    }
  }
}
