{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.campus_event_fit",
    "title": "Find a campus event sponsorship fit",
    "description": "A local founder compares supplied campus event briefs and gets one evidence-backed activation concept and a ranked shortlist.",
    "executor": "codex.procedure",
    "version": "1.0.0",
    "schedule_modes": ["on_demand"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "business", "audience", "event_briefs"],
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "business": {"type": "string", "minLength": 1, "maxLength": 1500, "title": "Business, product and offer", "x-tin-ui": {"control": "textarea", "order": 10}},
        "audience": {"type": "string", "minLength": 1, "maxLength": 1000, "title": "Target students and location", "x-tin-ui": {"control": "textarea", "order": 20}},
        "event_briefs": {"type": "string", "minLength": 1, "maxLength": 12000, "title": "Public event descriptions and source URLs", "x-tin-ui": {"control": "textarea", "order": 30}},
        "budget": {"type": "string", "maxLength": 300, "default": "", "title": "Budget or practical limits", "x-tin-ui": {"control": "textarea", "order": 40}}
      }
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": ["skills/campus-event-fit/SKILL.md"],
      "entry_skill": "campus-event-fit",
      "workspace": {"kind": "project.state"},
      "sandbox": {"profile": "isolated", "egress": "fenced", "timeout_seconds": 900},
      "output": {"kind": "project.artifact", "path": "reports/CAMPUS_EVENT_FIT.md", "media_type": "text/markdown", "max_bytes": 32000}
    }
  }
}
