{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.mention_to_backlink",
    "title": "Turn unlinked mentions into backlink asks",
    "description": "Find places online that already name the brand without linking to the site, and draft a personalized ask for each one to add the link.",
    "executor": "codex.procedure",
    "version": "1.0.0",
    "schedule_modes": ["on_demand", "weekly"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "brand_name", "domain"],
      "properties": {
        "project_id": { "type": "string", "format": "uuid" },
        "brand_name": {
          "type": "string",
          "title": "Brand or product name to search for",
          "minLength": 1,
          "maxLength": 200,
          "x-tin-ui": { "control": "text", "order": 10 }
        },
        "domain": {
          "type": "string",
          "title": "Site domain (no scheme, e.g. example.com)",
          "minLength": 3,
          "maxLength": 253,
          "x-tin-ui": { "control": "text", "order": 20 }
        },
        "aliases": {
          "type": "string",
          "title": "Other names people use for it",
          "description": "Founder name, former name, common misspelling, etc. One per line.",
          "maxLength": 1000,
          "default": "",
          "x-tin-ui": { "control": "textarea", "order": 30 }
        },
        "max_mentions": {
          "type": "integer",
          "title": "Mentions to fully investigate",
          "minimum": 3,
          "maximum": 30,
          "default": 15,
          "x-tin-ui": { "control": "counter", "order": 40 }
        },
        "recency_days": {
          "type": "integer",
          "title": "Prefer pages published within (days)",
          "description": "A soft recency preference, not a hard filter; older durable pages can still qualify.",
          "minimum": 7,
          "maximum": 730,
          "default": 180,
          "x-tin-ui": { "control": "counter", "order": 50 }
        }
      }
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": ["skills/mention-to-backlink/SKILL.md"],
      "entry_skill": "mention-to-backlink",
      "workspace": { "kind": "project.state" },
      "sandbox": { "profile": "isolated", "egress": "fenced", "timeout_seconds": 900 },
      "output": {
        "kind": "project.artifact",
        "path": "reports/MENTION_TO_BACKLINK.md",
        "media_type": "text/markdown",
        "max_bytes": 250000
      }
    }
  }
}
