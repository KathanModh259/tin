{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.pricing_watch",
    "title": "Watch competitor pricing & packaging",
    "description": "Inspect a competitor's pricing page, detect pricing or tier changes against prior runs, and produce an actionable commercial brief with a battlecard action matrix.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": [
      "on_demand",
      "weekly"
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "competitor_url": {
          "type": "string",
          "format": "uri",
          "minLength": 10,
          "maxLength": 500,
          "title": "Competitor pricing or homepage URL",
          "description": "Public HTTPS URL (e.g. https://competitor.com/pricing).",
          "x-tin-ui": {
            "control": "text",
            "order": 10
          }
        },
        "competitor_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "title": "Competitor name",
          "description": "Short brand name (e.g. Linear, PostHog, Supabase).",
          "x-tin-ui": {
            "control": "text",
            "order": 20
          }
        },
        "our_pricing_context": {
          "type": "string",
          "maxLength": 2000,
          "default": "",
          "title": "Your pricing & positioning (optional)",
          "description": "Summary of your tiers and key differentiators, used to contextualize threats and opportunities.",
          "x-tin-ui": {
            "control": "textarea",
            "order": 30
          }
        },
        "focus": {
          "type": "string",
          "maxLength": 2000,
          "default": "",
          "title": "Specific focus or questions (optional)",
          "description": "Specific areas to watch (e.g. 'Did they introduce seat minimums?' or 'Check AI add-on pricing').",
          "x-tin-ui": {
            "control": "textarea",
            "order": 40
          }
        }
      },
      "required": [
        "project_id",
        "competitor_url",
        "competitor_name"
      ]
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/pricing-watch/SKILL.md",
        "skills/pricing-watch/SCHEMA.md",
        "skills/pricing-watch/REPORT.md"
      ],
      "entry_skill": "pricing-watch",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 900
      },
      "output": {
        "kind": "project.artifact",
        "media_type": "text/markdown",
        "max_bytes": 150000,
        "path_template": "reports/pricing-watch/{run_id}.md"
      }
    }
  }
}
